[worldserver]

########################################
# Pet Loot Configuration
########################################
#
#    PetLoot.Enable
#        Description: Enable or disable the pet loot module.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PetLoot.Enable = 1

#
#    PetLoot.PetIds
#        Description: Comma-separated list of creature entries (Vanity Pets) that will perform the looting.
#                     Any pet whose entry is in the list can loot. Spaces around commas are allowed.
#                     Default pets:
#                       23234 - Bananas (TCG Monkey Pet)
#                       7547  - Azure Whelpling
#                       25146 - Golden Pig
#                       37865 - Perky Pug
#                       29089 - Mini Tyrael
#                       26119 - Phoenix Hatchling
#                       36911 - Pandaren Monk
#                       36511 - Spectral Tiger Cub
#        Default:     23234,7547,25146,37865,29089,26119,36911,36511

PetLoot.PetIds = 23234,7547,25146,37865,29089,26119,36911,36511

#
#    PetLoot.DebugLog
#        Description: Enable verbose per-kill/group-scan diagnostics in the worldserver log.
#        Default:     0 - (Disabled, no diagnostic logging)
#                     1 - (Enabled, log verbose per-kill/group-scan diagnostics)

PetLoot.DebugLog = 0

#
#    PetLoot.Radius
#        Description: The maximum distance (in yards) between the player and the corpse for the pet to loot.
#        Default:     50.0

PetLoot.Radius = 50.0

#
#    PetLoot.CacheTTL
#        Description: Seconds to reuse a group's previously found pet owner before a fresh scan is required.
#                     Every cached entry is fully revalidated on each kill: pet dismiss/death, player leaving
#                     the group, map/phase or distance changes force a fresh scan.
#        Default:     30.0
#                     0 - (Disabled, always rescan)

PetLoot.CacheTTL = 30.0

#
#    PetLoot.AllowInDungeons
#        Description: Allow the pet to loot in 5-player dungeon instances. 5-player dungeons
#                     and raids are configured separately; open world is unaffected by these
#                     instance toggles.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PetLoot.AllowInDungeons = 1

#
#    PetLoot.AllowInRaids
#        Description: Allow the pet to loot in raid instances.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

PetLoot.AllowInRaids = 1

#
#    PetLoot.AllowInBattlegrounds
#        Description: Allow the pet to loot in battleground (PvP) instances.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PetLoot.AllowInBattlegrounds = 0

#
#    PetLoot.AllowInArenas
#        Description: Allow the pet to loot in arena (PvP) instances.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

PetLoot.AllowInArenas = 0

#
#    PetLoot.SpeedMultiplier
#        Description: Movement-speed coefficient for the pet's trip to the corpse.
#                     1 = normal, 2 = double, 3 = triple. Clamped to 0.1-10.0.
#                     Normally only the outbound trip is affected; follow-home uses the
#                     player's speed. The fixed 1s loot delay is unchanged.
#        Default:     1.0

PetLoot.SpeedMultiplier = 1.0

#
#    PetLoot.RequireFreeForAll
#        Description: When enabled, the pet loots only if the group's loot method is
#                     Free For All. Under Group Loot, Need Before Greed, Master Loot or
#                     Round-Robin the pet does nothing. Solo kills are always allowed
#                     (no group is treated as implicit Free For All).
#        Default:     0 - (Disabled, loots under all loot methods)
#                     1 - (Enabled, Free For All only)

PetLoot.RequireFreeForAll = 0
